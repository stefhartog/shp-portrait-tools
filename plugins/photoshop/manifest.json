{
  "manifestVersion": 5,
  "id": "shp.skin-tools.connector",
  "name": "Skin Tools Connector",
  "version": "0.1.0",
  "main": "index.html",
  "host": [{"app": "PS", "minVersion": "28.0.0", "data": {"apiVersion": 2}}],
  "entrypoints": [{
    "type": "panel",
    "id": "skinTools",
    "label": {"default": "Skin Tools Connector"},
    "minimumSize": {"width": 280, "height": 360},
    "preferredDockedSize": {"width": 320, "height": 440}
  }],
  "requiredPermissions": {
    "network": {"domains": ["http://127.0.0.1:18765"]},
    "localFileSystem": "request"
  }
}
