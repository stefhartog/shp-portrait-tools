{
  "manifestVersion": 5,
  "id": "shp.skin-tools.connector",
  "name": "Skin Tools Connector",
  "version": "0.1.11",
  "main": "index.html",
  "host": [{"app": "PS", "minVersion": "28.0.0", "data": {"apiVersion": 2}}],
  "entrypoints": [{
    "type": "panel",
    "id": "skinTools",
    "label": {"default": "Skin Tools Connector"},
    "icons": [
      {"width": 23, "height": 23, "path": "icons/light.png", "scale": [1], "theme": ["darkest", "dark"]},
      {"width": 23, "height": 23, "path": "icons/dark.png", "scale": [1], "theme": ["lightest", "light"]}
    ],
    "minimumSize": {"width": 280, "height": 360},
    "preferredDockedSize": {"width": 320, "height": 440}
  }],
  "icons": [
    {"width": 23, "height": 23, "path": "icons/light.png", "scale": [1], "theme": ["darkest", "dark"]},
    {"width": 23, "height": 23, "path": "icons/dark.png", "scale": [1], "theme": ["lightest", "light"]}
  ],
  "requiredPermissions": {
    "network": {"domains": ["http://localhost:18765"]},
    "localFileSystem": "request"
  }
}
